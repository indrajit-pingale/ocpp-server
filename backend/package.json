{
  "name": "ocpp-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
    "start": "node -r ts-node/register src/main.ts",
    "build": "tsc -p tsconfig.json",
    "test": "jest --colors --runInBand",
    "clean-light": "rm -rf dist",
    "clean": "npm run clean-light && rm -rf node_modules",
    "watch": "npm run start:dev --watch"
  },
  "dependencies": {
    "@nestjs/common": "^9.0.0",
    "@nestjs/core": "^9.0.0",
    "@nestjs/platform-express": "^9.0.0",
    "@nestjs/typeorm": "^9.0.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.0.0",
    "typeorm": "^0.3.0",
    "mysql2": "^2.3.3",
    "class-validator": "^0.13.2",
    "class-transformer": "^0.5.1",
    "cors": "^2.8.5",
    "ws": "^8.13.0",
    "ajv": "^8.12.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.0",
    "argon2": "^0.30.0",
    "nodemailer": "^6.9.3",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@nestjs/testing": "^9.0.0",
    "@types/node": "^18.0.0",
    "@types/ws": "^8.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/bcryptjs": "^2.4.0",
    "@types/uuid": "^9.0.0",
    "@types/cors": "^2.8.0",
    "@types/nodemailer": "^6.4.0",
    "ts-node-dev": "^2.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^4.9.0",
    "jest": "^29.0.0",
    "ts-jest": "^29.0.0",
    "@types/jest": "^29.0.0"
  }
}
